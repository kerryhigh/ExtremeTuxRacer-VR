<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vr.headtracking"
                  android:version="1" android:required="true" />
    <uses-feature android:name="oculus.software.handtracking"
                  android:required="false" />

    <application>
        <meta-data android:name="com.oculus.supportedDevices" android:value="all" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <activity android:name="android.app.NativeActivity"
                  android:label="@string/app_name"
                  android:launchMode="singleTask"
                  android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode|density"
                  android:screenOrientation="landscape"
                  android:preferMinimalPostProcessing="true"
                  android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="etr" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
